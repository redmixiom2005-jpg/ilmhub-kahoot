# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://ilmhub-kahoot1.vercel.app"

# FIREBASE CONFIGURATION (Vercel Project Settings > Environment Variables)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="ilmhub-kahoot.firebaseapp.com"
# CRITICAL: For region asia-southeast1, databaseURL must end with .asia-southeast1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL="https://ilmhub-kahoot-default-rtdb.asia-southeast1.firebasedatabase.app"
VITE_FIREBASE_PROJECT_ID="ilmhub-kahoot"
VITE_FIREBASE_STORAGE_BUCKET="ilmhub-kahoot.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="1:your-sender-id:web:your-app-id"
